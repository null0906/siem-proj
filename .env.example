# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=seccomply
POSTGRES_USER=seccomply
POSTGRES_PASSWORD=change-me-in-production

# ── API service ───────────────────────────────────────────────────────────────
API_PORT=8080

# Optional: anonymous heartbeat endpoint (leave blank to disable)
HEARTBEAT_URL=

# Host port that Postgres is exposed on. Use 5433 to avoid clashing with a
# local Postgres instance on the default 5432.
POSTGRES_PORT=5433

# ── Ingestor ──────────────────────────────────────────────────────────────────
# Path inside the ingestor container that maps to your host inbox folder
WATCH_DIR=/data/inbox

# ── Frontend ──────────────────────────────────────────────────────────────────
WEB_PORT=3001

# URL the browser uses to reach the API. When both services run on the
# same host via docker compose, localhost works fine.
NEXT_PUBLIC_API_URL=http://localhost:8080
